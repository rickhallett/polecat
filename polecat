#!/bin/bash
# polecat — Sandboxed Claude CLI runner with tool restrictions and retry logic
# Polecats can read/write within their workdir but not outside, no destructive ops
#
# Key discoveries during development:
# 1. Claude CLI requires PTY even in -p mode (use `script -q /dev/null -c "..."`)
# 2. Must use -- separator before prompt to avoid arg parsing issues
# 3. ((attempt++)) returns 1 when incrementing from 0, triggers set -e (use || true)

set -euo pipefail

VERSION="0.2.0"
MAX_TRIES="${POLECAT_MAX_TRIES:-3}"
RETRY_DELAY="${POLECAT_RETRY_DELAY:-2}"

# Default tool permissions — read/write within workdir, safe bash only
ALLOWED_TOOLS=(
  "Read"
  "Write(./**)"
  "Edit(./**)"
  "Glob"
  "Grep"
  "LS"
  "Bash(cat:*)"
  "Bash(ls:*)"
  "Bash(head:*)"
  "Bash(tail:*)"
  "Bash(wc:*)"
  "Bash(grep:*)"
  "Bash(find:*)"
  "Bash(echo:*)"
  "Bash(pwd)"
  "Bash(date)"
)

# Explicitly denied — destructive/escape commands
DENIED_TOOLS=(
  "Bash(rm:*)"
  "Bash(sudo:*)"
  "Bash(curl:*)"
  "Bash(wget:*)"
  "Bash(chmod:*)"
  "Bash(chown:*)"
  "Bash(mv:*)"
  "Bash(cp:*)"
  "Bash(ssh:*)"
  "Bash(scp:*)"
  "Bash(rsync:*)"
  "Write(../*)"
  "Write(/*)"
  "Edit(../*)"
  "Edit(/*)"
)

usage() {
  cat <<EOF
polecat v${VERSION} — Sandboxed Claude CLI runner

USAGE:
  polecat [OPTIONS] <task>
  polecat [OPTIONS] -f <task-file>

OPTIONS:
  -w, --workdir DIR     Working directory (default: current dir)
  -m, --max-tries N     Max retry attempts (default: $MAX_TRIES)
  -d, --delay SECS      Delay between retries (default: $RETRY_DELAY)
  -f, --file FILE       Read task from file instead of argument
  -j, --json            Output JSON format
  -v, --verbose         Verbose output
  -h, --help            Show this help

ENVIRONMENT:
  POLECAT_MAX_TRIES     Override default max tries
  POLECAT_RETRY_DELAY   Override default retry delay

EXAMPLES:
  polecat "analyze this codebase and list issues"
  polecat -w ./sandbox -m 5 "fix the bug in main.py"
  polecat -f task.md --json
EOF
  exit 0
}

log() {
  echo "[polecat] $*" >&2
}

error() {
  echo "[polecat] ERROR: $*" >&2
}

# Parse arguments
WORKDIR="."
TASK=""
TASK_FILE=""
JSON_OUTPUT=false
VERBOSE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -w|--workdir)
      WORKDIR="$2"
      shift 2
      ;;
    -m|--max-tries)
      MAX_TRIES="$2"
      shift 2
      ;;
    -d|--delay)
      RETRY_DELAY="$2"
      shift 2
      ;;
    -f|--file)
      TASK_FILE="$2"
      shift 2
      ;;
    -j|--json)
      JSON_OUTPUT=true
      shift
      ;;
    -v|--verbose)
      VERBOSE=true
      shift
      ;;
    -h|--help)
      usage
      ;;
    -*)
      error "Unknown option: $1"
      exit 1
      ;;
    *)
      TASK="$1"
      shift
      ;;
  esac
done

# Get task from file if specified
if [[ -n "$TASK_FILE" ]]; then
  if [[ ! -f "$TASK_FILE" ]]; then
    error "Task file not found: $TASK_FILE"
    exit 1
  fi
  TASK=$(cat "$TASK_FILE")
fi

if [[ -z "$TASK" ]]; then
  error "No task provided"
  usage
fi

# Validate workdir
if [[ ! -d "$WORKDIR" ]]; then
  error "Working directory does not exist: $WORKDIR"
  exit 1
fi

# Convert to absolute path
WORKDIR=$(cd "$WORKDIR" && pwd)

# Build tool arguments
ALLOWED_ARG=$(IFS=','; echo "${ALLOWED_TOOLS[*]}")
DENIED_ARG=$(IFS=','; echo "${DENIED_TOOLS[*]}")

[[ "$VERBOSE" == true ]] && log "Workdir: $WORKDIR"
[[ "$VERBOSE" == true ]] && log "Max tries: $MAX_TRIES"
[[ "$VERBOSE" == true ]] && log "Allowed tools: $ALLOWED_ARG"

# Retry loop
attempt=0
last_exit=1
last_output=""

while [[ $attempt -lt $MAX_TRIES ]]; do
  ((attempt++)) || true  # Prevent errexit on arithmetic
  
  [[ "$VERBOSE" == true ]] && log "Attempt $attempt/$MAX_TRIES"
  
  # Build output format flag
  output_flag=""
  if [[ "$JSON_OUTPUT" == true ]]; then
    output_flag="--output-format json"
  fi
  
  # Run Claude with restrictions (needs PTY wrapper)
  set +e
  # Use script to provide PTY - claude requires it even in -p mode
  # IMPORTANT: Use -- separator before prompt to avoid arg parsing issues
  
  last_output=$(cd "$WORKDIR" && script -q /dev/null -c "claude -p \
    --allowed-tools \"$ALLOWED_ARG\" \
    --disallowed-tools \"$DENIED_ARG\" \
    $output_flag \
    -- \"$TASK\"" 2>&1)
  last_exit=$?
  
  # Strip ANSI/terminal escape sequences from output
  last_output=$(echo "$last_output" | \
    sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | \
    sed 's/\x1b\][^\x07]*\x07//g' | \
    sed 's/\x1b\][^\\]*\\//g' | \
    sed 's/\[<u//g' | \
    tr -d '\r')
  set -e
  
  if [[ $last_exit -eq 0 ]]; then
    [[ "$VERBOSE" == true ]] && log "Success on attempt $attempt"
    echo "$last_output"
    exit 0
  fi
  
  [[ "$VERBOSE" == true ]] && log "Failed with exit code $last_exit"
  
  if [[ $attempt -lt $MAX_TRIES ]]; then
    [[ "$VERBOSE" == true ]] && log "Retrying in ${RETRY_DELAY}s..."
    sleep "$RETRY_DELAY"
  fi
done

error "All $MAX_TRIES attempts failed"
[[ "$VERBOSE" == true ]] && log "Last output: $last_output"
exit $last_exit
